# Прод-конфигурация luder-server (переменные из этого файла перекрывают дефолты)
# Локально читается server.js без внешних зависимостей; НЕ коммитится (см. .gitignore)

# Хост/порт. За nginx оставь 127.0.0.1:3000
#HOST=0.0.0.0
#PORT=3000

# Включить, если сервер стоит ЗА реверс-прокси (nginx/Caddy):
# — rate-limit считает по X-Forwarded-For вместо ip прокси
TRUST_PROXY=1

# Прямой HTTPS (без nginx): путь к сертификату и ключу
#SSL_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
#SSL_KEY=/etc/letsencrypt/live/example.com/privkey.pem

# Лимит параллельных скачиваний инсталлятора и длина очереди
#MAX_DOWNLOADS=5
#MAX_DOWNLOAD_QUEUE=20

# Регистраций в минуту с одного IP
#REGISTER_LIMIT=5

# Токен доступа: если задан, /register требует Authorization: Bearer <токен>.
# Клиент передаёт его через LUDR_API_TOKEN (см. luder-program/config.js)
#AUTH_TOKEN=

# Ротация server.log при превышении размера (байты)
#LOG_MAX_BYTES=5242880
