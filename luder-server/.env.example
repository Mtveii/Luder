# Server port (default: 3000)
# PORT=3000

# Host to bind to (default: 127.0.0.1 — use 0.0.0.0 to expose externally)
# HOST=127.0.0.1

# Production: external base URL clients use to reach this server
# (used for absolute build URLs in the update manifest if not relative)
# PUBLIC_URL=https://luder.example.com
