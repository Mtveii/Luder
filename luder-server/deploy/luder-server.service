[Unit]
Description=Luder update/distribution server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/luder-server
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
# Минимум привилегий: свой пользователь, никакого root
User=luder
Group=luder
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/luder-server
# Не даём упасть по утечкам
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
