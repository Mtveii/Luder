{
  "name": "luder",
  "version": "0.17.1",
  "description": "Экранный AI-ассистент: хоткей → выделение области → ответ AI",
  "main": "main.js",
  "author": "Luder",
  "scripts": {
    "start": "electron .",
    "prebuild": "rimraf dist",
    "build": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux",
    "postbuild": "node scripts/verify-build.js",
    "test": "node test/run-all.js",
    "deploy": "cp dist/Luder-*.AppImage ../luder-server/dist/ 2>/dev/null; cp dist/luder_*.snap ../luder-server/dist/ 2>/dev/null; echo 'deployed'"
  },
  "build": {
    "appId": "com.luder.app",
    "productName": "Luder",
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Luder",
      "uninstallDisplayName": "Luder AI Assistant",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "installerLanguages": ["ru_RU", "en_US"],
      "artifactName": "${productName}-Setup-${version}-${arch}.exe"
    },
    "files": ["**/*", "!build${/*}", "!.env", "!.env.example"]
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "rimraf": "^5.0.0"
  },
  "dependencies": {}
}
